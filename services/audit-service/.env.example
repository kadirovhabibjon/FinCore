SERVICE_NAME=audit-service
ENVIRONMENT=local
LOG_LEVEL=INFO

# Distributed tracing (spec Section 24) — an OTLP HTTP collector
# (Jaeger in docker-compose).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

DATABASE_URL=postgresql+asyncpg://audit:audit@localhost:5432/audit_db

KAFKA_BOOTSTRAP_SERVERS=localhost:9094
TRANSFERS_TOPIC=transfers
PAYMENTS_TOPIC=payments
CONSUMER_GROUP_ID=audit-service

# Retry / DLT (spec Section 16).
RETRY_TOPIC=audit-retry
DLT_TOPIC=audit-dlt
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2.0

# Shared secret for /internal/* endpoints (Section 19) — the audit-log
# query API and the manual dead-letter replay API.
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-local-dev-value
