SERVICE_NAME=identity-service
ENVIRONMENT=local
LOG_LEVEL=INFO

# Distributed tracing (spec Section 24) — an OTLP HTTP collector
# (Jaeger in docker-compose).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

DATABASE_URL=postgresql+asyncpg://identity:identity@localhost:5432/identity_db

JWT_ISSUER=fincore-identity-service
JWT_KEY_ID=identity-2026-09
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Required, no default — generate your own local key, never commit a
# real one. Generate with:
#   openssl genpkey -algorithm ed25519
# then paste the PEM here as a single quoted, multi-line value:
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

# Browser refresh-token cookie (ADR-0006), used only when a client sends
# X-Refresh-Token-Transport: cookie. Keep Secure on everywhere except a
# plain-HTTP deployment that isn't localhost (browsers already accept
# Secure cookies on http://localhost).
REFRESH_COOKIE_SECURE=true

# Outbox relay (spec Section 14.1): account events go to the `users`
# topic for audit-service. Kafka being down never blocks login — events
# wait in outbox_events until the relay can publish them.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
