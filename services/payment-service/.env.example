SERVICE_NAME=payment-service
ENVIRONMENT=local
LOG_LEVEL=INFO

# Distributed tracing (spec Section 24) — an OTLP HTTP collector
# (Jaeger in docker-compose).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

DATABASE_URL=postgresql+asyncpg://payment:payment@localhost:5432/payment_db

IDENTITY_SERVICE_JWKS_URL=http://localhost:8091/.well-known/jwks.json
JWT_ISSUER=fincore-identity-service

# Must match ledger-service's own INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-local-dev-value

LEDGER_SERVICE_BASE_URL=http://localhost:8092
LEDGER_SERVICE_TIMEOUT_SECONDS=5.0

# fraud-service does not exist yet (spec Phase 5) — this points at a
# host that will refuse the connection, which is exactly what exercises
# the fail-open/fail-closed policy (Section 12) end to end before
# fraud-service is ever built.
FRAUD_SERVICE_BASE_URL=http://localhost:8093
FRAUD_SERVICE_TIMEOUT_SECONDS=0.3
FRAUD_FAIL_OPEN_LIMIT_MINOR=10000000

# Background loop that retries transfers left PROCESSING by an unknown
# ledger outcome (spec Section 10.1).
RECOVERY_WORKER_INTERVAL_SECONDS=30.0
RECOVERY_WORKER_STUCK_AFTER_SECONDS=60.0

# Outbox relay (spec Section 14.1) — publishes transfer.completed /
# transfer.failed to Kafka.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
OUTBOX_RELAY_INTERVAL_SECONDS=5.0
OUTBOX_RELAY_BATCH_SIZE=100
TRANSFERS_TOPIC=transfers
