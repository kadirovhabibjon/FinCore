SERVICE_NAME=notification-service
ENVIRONMENT=local
LOG_LEVEL=INFO

# Distributed tracing (spec Section 24) — an OTLP HTTP collector
# (Jaeger in docker-compose).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

DATABASE_URL=postgresql+asyncpg://notification:notification@localhost:5432/notification_db

KAFKA_BOOTSTRAP_SERVERS=localhost:9094
TRANSFERS_TOPIC=transfers
CONSUMER_GROUP_ID=notification-service

# Retry / DLT (spec Section 16).
RETRY_TOPIC=transfers-retry
DLT_TOPIC=transfers-dlt
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2.0

# Shared secret for /internal/* endpoints (Section 19) — the manual
# dead-letter replay API.
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-local-dev-value
