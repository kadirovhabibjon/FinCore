SERVICE_NAME=assistant-service
ENVIRONMENT=local
LOG_LEVEL=INFO

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Which model API answers: "anthropic" (Claude, paid) or
# "openai_compatible" (any Chat Completions API with tool calling; Google
# Gemini and Groq have free tiers). ./scripts/set-assistant-key.sh fills in
# the LLM_* values from a pasted key.
ASSISTANT_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-latest
# Tried in order when that model is overloaded or over its quota.
LLM_FALLBACK_MODELS=gemini-flash-lite-latest

# Claude API key from https://platform.claude.com (Settings → API Keys).
# Empty: the service still runs and the chat answers "not configured".
# Every message costs real API spend; RATE_LIMIT_* caps it per customer.
ANTHROPIC_API_KEY=
# Only for a key not scoped to a workspace ("sk-ant-usr-..."): the
# workspace id from Console → Settings → Workspaces ("wrkspc_...").
ANTHROPIC_WORKSPACE_ID=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=3600

# Customers' bearer tokens are verified locally against this JWKS, then
# relayed to these public APIs, which authorize each read themselves.
IDENTITY_SERVICE_JWKS_URL=http://localhost:8091/.well-known/jwks.json
JWT_ISSUER=fincore-identity-service
IDENTITY_SERVICE_BASE_URL=http://localhost:8091
LEDGER_SERVICE_BASE_URL=http://localhost:8092
PAYMENT_SERVICE_BASE_URL=http://localhost:8093
