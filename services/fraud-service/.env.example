SERVICE_NAME=fraud-service
ENVIRONMENT=local
LOG_LEVEL=INFO

# Distributed tracing (spec Section 24) — an OTLP HTTP collector
# (Jaeger in docker-compose).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

DATABASE_URL=postgresql+asyncpg://fraud:fraud@localhost:5432/fraud_db

# Shared secret for /internal/* endpoints (Section 19). payment-service
# must send this same value in the X-Internal-Token header.
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-local-dev-value

# Rule thresholds (spec Section 12's worked example).
LARGE_AMOUNT_THRESHOLD_MINOR=50000000
HIGH_FREQUENCY_WINDOW_SECONDS=60
HIGH_FREQUENCY_MAX_CHECKS=5
REPEATED_FAILURES_WINDOW_SECONDS=3600
REPEATED_FAILURES_MAX_COUNT=3
