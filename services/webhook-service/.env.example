SERVICE_NAME=webhook-service
ENVIRONMENT=local
LOG_LEVEL=INFO

# Distributed tracing (spec Section 24) — an OTLP HTTP collector
# (Jaeger in docker-compose).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

DATABASE_URL=postgresql+asyncpg://webhook:webhook@localhost:5432/webhook_db

# For verifying end-user (merchant owner) bearer tokens on the public
# endpoint-registration API.
IDENTITY_SERVICE_JWKS_URL=http://localhost:8091/.well-known/jwks.json
JWT_ISSUER=fincore-identity-service

# Must match payment-service's own INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-local-dev-value

PAYMENT_SERVICE_BASE_URL=http://localhost:8093
PAYMENT_SERVICE_TIMEOUT_SECONDS=5.0

# Kafka consumer (spec Section 14.3) — payment.completed/failed/refunded.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
PAYMENTS_TOPIC=payments
CONSUMER_GROUP_ID=webhook-service

# Delivery worker (spec Section 17).
DELIVERY_WORKER_INTERVAL_SECONDS=5.0
DELIVERY_WORKER_BATCH_SIZE=100

# Retry with backoff. attempts is 1-indexed; a delivery is marked
# terminally FAILED once it reaches MAX_DELIVERY_ATTEMPTS.
MAX_DELIVERY_ATTEMPTS=6
RETRY_BASE_DELAY_SECONDS=5.0

# Timeout for a single HTTP delivery attempt.
DELIVERY_TIMEOUT_SECONDS=5.0

# Endpoint auto-disabled after this many consecutive terminally-failed
# deliveries (spec Section 17).
DISABLE_ENDPOINT_AFTER_CONSECUTIVE_FAILURES=10
