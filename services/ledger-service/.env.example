SERVICE_NAME=ledger-service
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5432/ledger_db

# identity-service's JWKS endpoint — used to verify user bearer tokens
# locally, without calling identity-service per request.
IDENTITY_SERVICE_JWKS_URL=http://localhost:8091/.well-known/jwks.json
JWT_ISSUER=fincore-identity-service

# Shared secret for /internal/* endpoints (Section 19). Every service
# that calls ledger-service's internal API must send this same value in
# the X-Internal-Token header. Generate your own for local dev — never
# commit a real one.
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-local-dev-value
