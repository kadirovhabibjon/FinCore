{
  "components": {
    "schemas": {
      "AccountKind": {
        "description": "Account kinds and their normal balance side (ADR-0002):\n\nUSER_WALLET / MERCHANT_SETTLEMENT / FEES  -> CREDIT-normal (liability/revenue)\nEXTERNAL_FUNDING                          -> DEBIT-normal  (clearing)\nEXTERNAL_PAYOUT                           -> CREDIT-normal (clearing)\nSUSPENSE                                  -> no normal side; must net to zero",
        "enum": [
          "USER_WALLET",
          "EXTERNAL_FUNDING",
          "EXTERNAL_PAYOUT",
          "MERCHANT_SETTLEMENT",
          "FEES",
          "SUSPENSE"
        ],
        "title": "AccountKind",
        "type": "string"
      },
      "AccountStatus": {
        "enum": [
          "ACTIVE",
          "FROZEN",
          "CLOSED"
        ],
        "title": "AccountStatus",
        "type": "string"
      },
      "CaptureHoldRequest": {
        "properties": {
          "amount_minor": {
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor",
            "type": "integer"
          },
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "source_service": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Source Service",
            "type": "string"
          }
        },
        "required": [
          "source_service",
          "source_id",
          "amount_minor"
        ],
        "title": "CaptureHoldRequest",
        "type": "object"
      },
      "CreateHoldRequest": {
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "amount_minor": {
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor",
            "type": "integer"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "source_service": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Source Service",
            "type": "string"
          },
          "ttl_seconds": {
            "default": 900,
            "exclusiveMinimum": 0.0,
            "title": "Ttl Seconds",
            "type": "integer"
          }
        },
        "required": [
          "source_service",
          "source_id",
          "account_id",
          "amount_minor",
          "currency"
        ],
        "title": "CreateHoldRequest",
        "type": "object"
      },
      "CreatePostingRequest": {
        "properties": {
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/EntryRequest"
            },
            "minItems": 2,
            "title": "Entries",
            "type": "array"
          },
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "source_service": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Source Service",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/PostingType"
          }
        },
        "required": [
          "source_service",
          "source_id",
          "type",
          "currency",
          "entries"
        ],
        "title": "CreatePostingRequest",
        "type": "object"
      },
      "EntryDirection": {
        "enum": [
          "DEBIT",
          "CREDIT"
        ],
        "title": "EntryDirection",
        "type": "string"
      },
      "EntryRequest": {
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "amount_minor": {
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor",
            "type": "integer"
          },
          "direction": {
            "$ref": "#/components/schemas/EntryDirection"
          }
        },
        "required": [
          "account_id",
          "direction",
          "amount_minor"
        ],
        "title": "EntryRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HoldResponse": {
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "resolved_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved At"
          },
          "status": {
            "$ref": "#/components/schemas/HoldStatus"
          }
        },
        "required": [
          "id",
          "account_id",
          "amount_minor",
          "currency",
          "status",
          "created_at",
          "expires_at",
          "resolved_at"
        ],
        "title": "HoldResponse",
        "type": "object"
      },
      "HoldStatus": {
        "enum": [
          "ACTIVE",
          "CAPTURED",
          "RELEASED",
          "EXPIRED"
        ],
        "title": "HoldStatus",
        "type": "string"
      },
      "LedgerEntryResponse": {
        "properties": {
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "direction": {
            "$ref": "#/components/schemas/EntryDirection"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "posting_id": {
            "format": "uuid",
            "title": "Posting Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "posting_id",
          "direction",
          "amount_minor",
          "currency",
          "created_at"
        ],
        "title": "LedgerEntryResponse",
        "type": "object"
      },
      "PostingResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "source_service": {
            "title": "Source Service",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/PostingType"
          }
        },
        "required": [
          "id",
          "source_service",
          "source_id",
          "type",
          "currency",
          "created_at"
        ],
        "title": "PostingResponse",
        "type": "object"
      },
      "PostingType": {
        "description": "Mirrors the business operation types (spec Section 7.1). A posting\nalways exists *because* payment-service asked for one of these; the\ntype is recorded so `(source_service, source_id, type)` can be a\nprecise idempotency key \u2014 the same transfer could in principle\nproduce more than one posting type over its life (e.g. a payment's\ncapture vs. its later refund).",
        "enum": [
          "TRANSFER",
          "PAYMENT",
          "DEPOSIT",
          "WITHDRAWAL",
          "REFUND"
        ],
        "title": "PostingType",
        "type": "string"
      },
      "ReconciliationReportResponse": {
        "properties": {
          "balance_mismatches": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Balance Mismatches",
            "type": "array"
          },
          "duplicate_source_postings": {
            "items": {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            "title": "Duplicate Source Postings",
            "type": "array"
          },
          "is_clean": {
            "title": "Is Clean",
            "type": "boolean"
          },
          "negative_available_wallets": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Negative Available Wallets",
            "type": "array"
          },
          "unbalanced_postings": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Unbalanced Postings",
            "type": "array"
          }
        },
        "required": [
          "is_clean",
          "unbalanced_postings",
          "balance_mismatches",
          "negative_available_wallets",
          "duplicate_source_postings"
        ],
        "title": "ReconciliationReportResponse",
        "type": "object"
      },
      "SystemAccountResponse": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AccountKind"
          }
        },
        "required": [
          "id",
          "kind",
          "currency"
        ],
        "title": "SystemAccountResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WalletByCardResponse": {
        "description": "Who a card number belongs to - for payment-service, which shows\nthe sender a recipient before a transfer. Never exposed publicly:\nit carries the owner's user id.",
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "owner_user_id": {
            "format": "uuid",
            "title": "Owner User Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          }
        },
        "required": [
          "id",
          "owner_user_id",
          "currency",
          "status"
        ],
        "title": "WalletByCardResponse",
        "type": "object"
      },
      "WalletCreateRequest": {
        "properties": {
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "currency"
        ],
        "title": "WalletCreateRequest",
        "type": "object"
      },
      "WalletResponse": {
        "properties": {
          "balance_minor": {
            "title": "Balance Minor",
            "type": "integer"
          },
          "card_number": {
            "title": "Card Number",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "held_minor": {
            "title": "Held Minor",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          }
        },
        "required": [
          "id",
          "card_number",
          "currency",
          "status",
          "created_at",
          "balance_minor",
          "held_minor"
        ],
        "title": "WalletResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "FinCore Ledger Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/wallets": {
      "get": {
        "operationId": "list_my_wallets_api_v1_wallets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WalletResponse"
                  },
                  "title": "Response List My Wallets Api V1 Wallets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List My Wallets",
        "tags": [
          "wallets"
        ]
      },
      "post": {
        "operationId": "open_wallet_api_v1_wallets_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WalletCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Open Wallet",
        "tags": [
          "wallets"
        ]
      }
    },
    "/api/v1/wallets/{wallet_id}": {
      "get": {
        "operationId": "get_wallet_api_v1_wallets__wallet_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "wallet_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Wallet Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Wallet",
        "tags": [
          "wallets"
        ]
      }
    },
    "/api/v1/wallets/{wallet_id}/entries": {
      "get": {
        "operationId": "list_wallet_entries_api_v1_wallets__wallet_id__entries_get",
        "parameters": [
          {
            "in": "path",
            "name": "wallet_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Wallet Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LedgerEntryResponse"
                  },
                  "title": "Response List Wallet Entries Api V1 Wallets  Wallet Id  Entries Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Wallet Entries",
        "tags": [
          "wallets"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness: is the process up. No dependency checks.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/internal/v1/accounts/system": {
      "get": {
        "description": "Lets a caller (payment-service, building a refund posting) look\nup the id of a pooled system account (e.g. MERCHANT_SETTLEMENT for\na currency) without needing to know or store it itself \u2014 the same\nreason `capture_hold` looks this account up internally rather than\nrequiring the caller to pass its id (app/services/holds.py).",
        "operationId": "get_system_account_internal_v1_accounts_system_get",
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AccountKind"
            }
          },
          {
            "in": "query",
            "name": "currency",
            "required": true,
            "schema": {
              "maxLength": 3,
              "minLength": 3,
              "title": "Currency",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-internal-token",
            "required": true,
            "schema": {
              "title": "X-Internal-Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemAccountResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get System Account",
        "tags": [
          "internal"
        ]
      }
    },
    "/internal/v1/accounts/wallet-by-card": {
      "get": {
        "description": "The wallet a card number belongs to, whatever its status: whether\na frozen or closed wallet may receive money is the caller's rule.",
        "operationId": "get_wallet_by_card_internal_v1_accounts_wallet_by_card_get",
        "parameters": [
          {
            "in": "query",
            "name": "card_number",
            "required": true,
            "schema": {
              "maxLength": 16,
              "minLength": 16,
              "pattern": "^[0-9]{16}$",
              "title": "Card Number",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-internal-token",
            "required": true,
            "schema": {
              "title": "X-Internal-Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletByCardResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Wallet By Card",
        "tags": [
          "internal"
        ]
      }
    },
    "/internal/v1/holds": {
      "post": {
        "operationId": "post_hold_internal_v1_holds_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-internal-token",
            "required": true,
            "schema": {
              "title": "X-Internal-Token",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHoldRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HoldResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Hold",
        "tags": [
          "internal"
        ]
      }
    },
    "/internal/v1/holds/{hold_id}/capture": {
      "post": {
        "operationId": "post_capture_internal_v1_holds__hold_id__capture_post",
        "parameters": [
          {
            "in": "path",
            "name": "hold_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Hold Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-internal-token",
            "required": true,
            "schema": {
              "title": "X-Internal-Token",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureHoldRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
