            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MerchantResponse"
                  },
                  "title": "Response List My Merchants Api V1 Merchants Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List My Merchants",
        "tags": [
          "merchants"
        ]
      },
      "post": {
        "operationId": "create_merchant_api_v1_merchants_post",
