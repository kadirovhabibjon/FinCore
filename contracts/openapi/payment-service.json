          "merchant_id",
          "amount",
          "currency"
        ],
        "title": "CreatePaymentRequest",
        "type": "object"
      },
      "CreateRefundRequest": {
        "properties": {
          "amount": {
            "maxLength": 32,
            "minLength": 1,
