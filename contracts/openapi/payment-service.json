            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "merchant_id": {
            "format": "uuid",
            "title": "Merchant Id",
            "type": "string"
          },
          "source_wallet_id": {
            "format": "uuid",
            "title": "Source Wallet Id",
            "type": "string"
          }
        },
        "required": [
