          "destination_wallet_id",
          "amount",
          "currency"
        ],
        "title": "CreateTransferRequest",
        "type": "object"
      },
      "FraudDecision": {
        "enum": [
          "ALLOW",
          "REVIEW",
          "BLOCK"
        ],
        "title": "FraudDecision",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MerchantOwnershipResponse": {
        "description": "Lets a caller (webhook-service, registering a webhook endpoint)\nverify who owns a merchant and whether it's active, without needing\nits own copy of the merchants table \u2014 same reasoning as\nledger-service's SystemAccountResponse.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "owner_user_id": {
            "format": "uuid",
            "title": "Owner User Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/MerchantStatus"
          }
        },
        "required": [
          "id",
          "owner_user_id",
          "status"
        ],
        "title": "MerchantOwnershipResponse",
        "type": "object"
      },
      "MerchantResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "owner_user_id": {
            "format": "uuid",
            "title": "Owner User Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/MerchantStatus"
          }
        },
        "required": [
          "id",
          "owner_user_id",
          "name",
          "status",
          "created_at"
        ],
        "title": "MerchantResponse",
        "type": "object"
      },
      "MerchantStatus": {
        "enum": [
          "ACTIVE",
          "SUSPENDED"
        ],
        "title": "MerchantStatus",
        "type": "string"
      },
      "PaymentResponse": {
        "properties": {
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "fraud_decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FraudDecision"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "merchant_id": {
            "format": "uuid",
            "title": "Merchant Id",
            "type": "string"
          },
          "reference": {
            "title": "Reference",
            "type": "string"
          },
          "refunded_amount_minor": {
            "title": "Refunded Amount Minor",
            "type": "integer"
          },
          "source_wallet_id": {
            "format": "uuid",
            "title": "Source Wallet Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "reference",
          "source_wallet_id",
          "merchant_id",
          "amount_minor",
          "currency",
          "status",
          "failure_reason",
          "fraud_decision",
          "refunded_amount_minor",
          "description",
          "created_at",
          "updated_at",
          "completed_at"
        ],
        "title": "PaymentResponse",
        "type": "object"
      },
      "PaymentStatus": {
        "description": "State machine (spec Section 11), enforced the same way Transfer's\nis: every transition is an atomic `UPDATE ... WHERE status =\n:expected` (`PaymentRepository.transition_status`), never assumed\nfrom in-memory state.\n\nCREATED             -> PROCESSING | FAILED | EXPIRED\nPROCESSING          -> SUCCESS | FAILED\nSUCCESS             -> REFUNDED (full) | PARTIALLY_REFUNDED\nPARTIALLY_REFUNDED  -> REFUNDED\nFAILED, EXPIRED, REFUNDED -> terminal",
        "enum": [
          "CREATED",
          "PROCESSING",
          "SUCCESS",
          "FAILED",
          "EXPIRED",
          "PARTIALLY_REFUNDED",
          "REFUNDED"
        ],
        "title": "PaymentStatus",
        "type": "string"
      },
      "RefundResponse": {
        "properties": {
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "payment_id": {
            "format": "uuid",
            "title": "Payment Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "$ref": "#/components/schemas/RefundStatus"
          }
        },
        "required": [
          "id",
          "payment_id",
          "amount_minor",
          "reason",
          "status",
          "failure_reason",
          "created_at"
        ],
        "title": "RefundResponse",
        "type": "object"
      },
      "RefundStatus": {
        "description": "A minimal state machine \u2014 not the full Payment/Transfer saga\ntreatment, but the same underlying reason those have one: the\nledger posting a refund makes is itself only reachable over the\nnetwork, so an unknown outcome (timeout, 5xx) has to leave *some*\ndurable, retriable state rather than nothing at all \u2014 otherwise a\nretried refund request would mint a fresh id each time and risk a\nduplicate posting instead of safely retrying the same one.",
        "enum": [
          "PENDING",
          "COMPLETED",
          "FAILED"
        ],
        "title": "RefundStatus",
        "type": "string"
      },
      "TransactionResponse": {
        "description": "A type-erased view over any business operation (Transfer or\nPayment) for the user-facing history endpoints\n(`GET /api/v1/transactions[/{id}]`) \u2014 distinct from\n`TransferResponse`/`PaymentResponse`, which are type-specific and\nused by their own APIs.",
        "properties": {
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "reference": {
            "title": "Reference",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          }
        },
        "required": [
          "id",
          "type",
          "reference",
          "status",
          "amount_minor",
          "currency",
          "description",
          "created_at",
          "completed_at"
        ],
        "title": "TransactionResponse",
        "type": "object"
      },
      "TransactionType": {
        "description": "The kind of business operation a transaction summarizes (spec\nSection 20's API map).",
        "enum": [
          "TRANSFER",
          "PAYMENT"
        ],
        "title": "TransactionType",
        "type": "string"
      },
      "TransferResponse": {
        "properties": {
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "destination_wallet_id": {
            "format": "uuid",
            "title": "Destination Wallet Id",
            "type": "string"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "fraud_decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FraudDecision"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "reference": {
            "title": "Reference",
            "type": "string"
          },
          "source_wallet_id": {
            "format": "uuid",
            "title": "Source Wallet Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TransferStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "reference",
          "source_wallet_id",
          "destination_wallet_id",
          "amount_minor",
          "currency",
          "status",
          "failure_reason",
          "fraud_decision",
          "description",
          "created_at",
          "updated_at",
          "completed_at"
        ],
        "title": "TransferResponse",
        "type": "object"
      },
      "TransferStatus": {
        "description": "State machine (spec Section 7.3). Allowed transitions:\n\nPENDING     -> PROCESSING | CANCELLED | FAILED\nPROCESSING  -> COMPLETED  | FAILED\nCOMPLETED   -> (terminal)\nFAILED      -> (terminal)\nCANCELLED   -> (terminal)\n\nEnforced in app/services/transfers.py, and guarded at the database\nupdate with `WHERE status = :expected` \u2014 never assumed from\nin-memory state alone.",
        "enum": [
          "PENDING",
          "PROCESSING",
          "COMPLETED",
          "FAILED",
          "CANCELLED"
        ],
        "title": "TransferStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "FinCore Payment Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
