            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "amount"
        ],
        "title": "CreateRefundRequest",
        "type": "object"
      },
      "CreateTransferRequest": {
        "properties": {
          "amount": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "destination_wallet_id": {
            "format": "uuid",
            "title": "Destination Wallet Id",
            "type": "string"
          },
          "source_wallet_id": {
            "format": "uuid",
            "title": "Source Wallet Id",
            "type": "string"
          }
        },
        "required": [
