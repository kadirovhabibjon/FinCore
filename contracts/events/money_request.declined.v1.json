{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fincore.local/contracts/events/money_request.declined.v1.json",
  "title": "money_request.declined (v1) \u2014 EventEnvelope.data",
  "description": "The person asked declined a money request. Producer: payment-service, topic `transfers`. Strict (additionalProperties: false) so any change to the payload is a reviewed contract change, never a silent one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_user_id",
    "amount_minor",
    "currency",
    "payer_user_id",
    "reference",
    "request_id",
    "requester_user_id",
    "status"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "requester_user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Who asked for the money."
    },
    "payer_user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Who was asked."
    },
    "actor_user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Who did this: the requester when a request is created, the person asked when it is declined."
    },
    "requester_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "The requester as \"First L.\"."
    },
    "payer_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "The person asked, as \"First L.\"."
    },
    "amount_minor": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "description": "The requester's own words to the payer."
    },
    "status": {
      "enum": [
        "DECLINED"
      ]
    }
  },
  "examples": [
    {
      "request_id": "2c1f7a3e-5b6d-4e8f-9a0b-1c2d3e4f5a6b",
      "reference": "REQ-9F2A7C41D0B3",
      "requester_user_id": "5b1e0c2a-9f3d-4c1e-8a7b-2d4f6e8a0c1e",
      "payer_user_id": "3d6f0a1b-2c4e-4f8a-9b7c-5e1d2f3a4b6c",
      "requester_name": "Aziza K.",
      "payer_name": "Bobur T.",
      "amount_minor": 5000000,
      "currency": "UZS",
      "note": "Dinner",
      "status": "DECLINED",
      "actor_user_id": "3d6f0a1b-2c4e-4f8a-9b7c-5e1d2f3a4b6c"
    }
  ]
}
