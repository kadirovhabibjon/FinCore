{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fincore.local/contracts/events/transfer.completed.v1.json",
  "title": "transfer.completed (v1) \u2014 EventEnvelope.data",
  "description": "Payload of the `data` field for this event type (spec Section 14.2's envelope, Section 14.3's event list). Producer: payment-service. Strict (additionalProperties: false) so any change to the payload is a reviewed contract change, never a silent one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amount_minor",
    "completed_at",
    "currency",
    "failure_reason",
    "initiator_user_id",
    "reference",
    "status",
    "transfer_id"
  ],
  "properties": {
    "transfer_id": {
      "type": "string",
      "format": "uuid"
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "initiator_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "recipient_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Owner of the destination wallet. Optional: null or absent when it could not be looked up, and on events published before this field existed."
    },
    "sender_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "The initiator as \"First L.\", for messages to the recipient. Optional."
    },
    "recipient_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "The recipient as \"First L.\", for messages to the sender. Optional."
    },
    "amount_minor": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "COMPLETED"
      ]
    }
  },
  "examples": [
    {
      "transfer_id": "8f14e45f-ceea-4e7a-9c3b-1d2f3a4b5c6d",
      "reference": "TRF-0A1B2C3D4E5F",
      "initiator_user_id": "1c9a7e2b-3d4f-4a5b-8c6d-7e8f9a0b1c2d",
      "amount_minor": 25000,
      "currency": "UZS",
      "failure_reason": null,
      "status": "COMPLETED",
      "completed_at": "2026-01-01T12:00:00+00:00",
      "recipient_user_id": "3d6f0a1b-2c4e-4f8a-9b7c-5e1d2f3a4b6c",
      "sender_name": "Aziza K.",
      "recipient_name": "Bobur T."
    }
  ]
}
